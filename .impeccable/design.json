  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The Ask action: solid ink, 50px, no icon.",
      "html": "<button class=\"ds-btn-primary\">Ask</button>",
      "css": ":host{--paper:#faf8f3;--sheet:#fff;--ink:#1c1b19;--ink-2:#45433e;--ink-3:#6b675f;--rule:#dedad0;--rule-strong:#b5b0a4;--maroon:#7a1f1f;--maroon-deep:#641818;--maroon-wash:#f4e8e4;--maroon-line:#d9b9b2;--sans:'Hind','Segoe UI',system-ui,sans-serif;--serif:'Noto Serif',Georgia,serif;font-family:var(--sans);color:var(--ink)}.ds-btn-primary{height:50px;padding:0 32px;background:var(--ink);color:#fff;border:0;border-radius:2px;font:600 17px var(--sans);cursor:pointer;transition:background-color 160ms}.ds-btn-primary:hover{background:#000}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Cancel in the loading state.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ":host{--paper:#faf8f3;--sheet:#fff;--ink:#1c1b19;--ink-2:#45433e;--ink-3:#6b675f;--rule:#dedad0;--rule-strong:#b5b0a4;--maroon:#7a1f1f;--maroon-deep:#641818;--maroon-wash:#f4e8e4;--maroon-line:#d9b9b2;--sans:'Hind','Segoe UI',system-ui,sans-serif;--serif:'Noto Serif',Georgia,serif;font-family:var(--sans);color:var(--ink)}.ds-btn-ghost{height:36px;padding:0 12px;background:transparent;border:1px solid var(--rule-strong);border-radius:2px;color:var(--ink-2);font:15px var(--sans);cursor:pointer}.ds-btn-ghost:hover{border-color:var(--ink);color:var(--ink)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Ask Input",
      "kind": "input",
      "refersTo": "input-ask",
      "description": "The question box.",
      "html": "<input class=\"ds-input-ask\" placeholder=\"e.g. Can I take back my consent later?\">",
      "css": ":host{--paper:#faf8f3;--sheet:#fff;--ink:#1c1b19;--ink-2:#45433e;--ink-3:#6b675f;--rule:#dedad0;--rule-strong:#b5b0a4;--maroon:#7a1f1f;--maroon-deep:#641818;--maroon-wash:#f4e8e4;--maroon-line:#d9b9b2;--sans:'Hind','Segoe UI',system-ui,sans-serif;--serif:'Noto Serif',Georgia,serif;font-family:var(--sans);color:var(--ink)}.ds-input-ask{width:100%;height:50px;padding:0 16px;font:18px var(--sans);background:#fff;border:1px solid var(--rule-strong);border-radius:2px;outline:0;color:var(--ink)}.ds-input-ask::placeholder{color:var(--ink-3)}.ds-input-ask:focus{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}"
    },
    {
      "name": "Example Questions",
      "kind": "chip",
      "refersTo": "example-link",
      "description": "Underlined example questions separated by middots.",
      "html": "<p class=\"ds-examples\"><span>For example:</span><button class=\"ds-ex\">after a data breach</button><button class=\"ds-ex\">who is a child</button><button class=\"ds-ex\">something outside the Act</button></p>",
      "css": ":host{--paper:#faf8f3;--sheet:#fff;--ink:#1c1b19;--ink-2:#45433e;--ink-3:#6b675f;--rule:#dedad0;--rule-strong:#b5b0a4;--maroon:#7a1f1f;--maroon-deep:#641818;--maroon-wash:#f4e8e4;--maroon-line:#d9b9b2;--sans:'Hind','Segoe UI',system-ui,sans-serif;--serif:'Noto Serif',Georgia,serif;font-family:var(--sans);color:var(--ink)}.ds-examples{display:flex;flex-wrap:wrap;align-items:baseline;font:15.5px var(--sans);color:var(--ink-3);margin:0}.ds-examples span{margin-right:8px}.ds-ex{background:none;border:0;padding:0;cursor:pointer;font:inherit;color:var(--maroon-deep);text-decoration:underline;text-decoration-color:var(--maroon-line);text-underline-offset:3px}.ds-ex:hover{text-decoration-color:currentColor}.ds-ex:not(:last-child)::after{content:'\\00b7';display:inline-block;padding:0 9px;color:var(--ink-3);text-decoration:none}"
    },
    {
      "name": "Section Cells",
      "kind": "nav",
